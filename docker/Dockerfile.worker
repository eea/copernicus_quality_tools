# Security-sensitive infrastructure dependencies are pinned and checksum-verified.
# Update the version and digest together from the upstream release metadata.
ARG JETTY_VERSION=9.4.58.v20250814
ARG JETTY_SHA256=84eee992b75b72cf2e49c7d34445f49c18602904e10b42a72aedbebe410074e1
ARG SQUID_VERSION=7.7
ARG SQUID_RELEASE_TAG=SQUID_7_7
ARG SQUID_SHA256=5b05417d681c3cca275bc48ede12ee50a3e7d60cb47fb94522ee3a66022a8c59

# --- First Stage: Build Jetty for INSPIRE validator ---
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac AS jetty-builder
ARG JETTY_VERSION
ARG JETTY_SHA256
ARG SQUID_VERSION
ARG SQUID_RELEASE_TAG
ARG SQUID_SHA256
ARG BUILD_JOBS=2
RUN JETTY_HOME=/usr/local/jetty \
    && mkdir -p "${JETTY_HOME}" \
    && apt-get update && apt-get install -y --no-install-recommends wget unzip build-essential curl libssl-dev \
    libgnutls28-dev pkg-config ca-certificates \
    && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
        "https://repo1.maven.org/maven2/org/eclipse/jetty/jetty-distribution/${JETTY_VERSION}/jetty-distribution-${JETTY_VERSION}.tar.gz" \
        --output /tmp/jetty.tar.gz \
    && echo "${JETTY_SHA256}  /tmp/jetty.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/jetty.tar.gz -C "${JETTY_HOME}" --strip-components=1 \
    && rm /tmp/jetty.tar.gz \
    && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------
# Build the pinned Squid security release from source.
RUN curl --fail --show-error --location --proto '=https' --tlsv1.2 \
        "https://github.com/squid-cache/squid/releases/download/${SQUID_RELEASE_TAG}/squid-${SQUID_VERSION}.tar.gz" \
        --output /tmp/squid.tar.gz && \
    echo "${SQUID_SHA256}  /tmp/squid.tar.gz" | sha256sum --check --strict && \
    tar -xzf /tmp/squid.tar.gz -C /tmp && cd "/tmp/squid-${SQUID_VERSION}" && \
    ./configure --prefix=/usr \
            --sysconfdir=/etc/squid \
            --localstatedir=/var \
            --libexecdir=/usr/lib/squid \
            --srcdir=. \
            --with-default-user=proxy \
            --with-gnutls && \
    make -j"${BUILD_JOBS}" && make install && \
    rm -rf /tmp/squid.tar.gz "/tmp/squid-${SQUID_VERSION}"


# --- Second Stage: Build the remainder of the image ---    
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ARG JETTY_VERSION
ARG INSPIRE_VALIDATOR_VERSION=2026.1.1
ARG INSPIRE_VALIDATOR_SHA256=091ddeb2c16c96ecdb4257bd49f62c6b1b65d471292579e090e5989b93d1d8f3
ARG INSPIRE_RESOURCES_VERSION=2026.1
ARG INSPIRE_RESOURCES_SHA256=5978567ff49c4d7485c2d0a963aada367a63df8631f2559f1bbdc7b673a297ff
ARG INSPIRE_ETS_SHA256=ea2c3994cc1fef720dabfa1a85f1fc50602032ec7b39ae038489a647f86c5e3b

LABEL author=gisat.cz
LABEL description="QC tool environment, worker service."

ARG VERSION
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/eea/copernicus_quality_tools" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
ARG BUILD_JOBS=2
ARG ARROW_VERSION=17.0.0-1
ARG GDAL_SHA256=c435a2ec08eca3d4c2bfe774081f8c433c00e56ee2f0f2f4f6494c2d078fcfb9

ENV PYTHONPATH=/usr/local/src/copernicus_quality_tools/src
ENV VERSION=${VERSION}
ENV PATH=/opt/qc-tool/bin:$PATH
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV QC_TOOL_ENVIRONMENT=production

# Set environment variables for INSPIRE validator
ENV DEBIAN_FRONTEND=noninteractive
ENV ETF_DIR=/etf
ENV ETF_LOG_DIR=/etf/logs

ENV ETF_DL_TESTPROJECTS_DIR_NAME=inspire-ets-repository
ENV ETF_DL_TESTPROJECTS_OVERWRITE_EXISTING=true
ENV HTTP_PROXY_HOST=localhost
ENV HTTP_PROXY_PORT=3128
ENV HTTPS_PROXY_HOST=none
ENV HTTPS_PROXY_PORT=3129
# Set the Jetty version for INSPIRE validator.
ENV JETTY_VERSION=${JETTY_VERSION}
ENV JETTY_HOME=/usr/local/jetty
ENV INSPIRE_VALIDATOR_VERSION=${INSPIRE_VALIDATOR_VERSION}
ENV INSPIRE_RESOURCES_VERSION=${INSPIRE_RESOURCES_VERSION}
ENV JAVA_MAX_MEM=1536
ENV SQUID_CACHE_MEM_MB=256
ENV MALLOC_ARENA_MAX=2

COPY --from=jetty-builder /usr/local/jetty /usr/local/jetty

# Copy the Squid binaries from the builder stage.
COPY --from=jetty-builder /usr/sbin/squid /usr/sbin/squid
COPY --from=jetty-builder /usr/lib/squid /usr/lib/squid
COPY --from=jetty-builder /etc/squid /etc/squid


# Copy the squid icons
COPY --from=jetty-builder /usr/share/errors /usr/share/errors
COPY --from=jetty-builder /usr/share/icons /usr/share/icons
COPY --from=jetty-builder /usr/share/mib.txt /usr/share/mib.txt


# We create /var/logs (with an 's') because your config specifically asks for it
RUN mkdir -p /var/logs /var/log/squid /var/spool/squid /var/run/squid && \
    touch /var/logs/access.log /var/logs/cache.log && \
    chown -R proxy:proxy /var/logs /var/log/squid /var/spool/squid /var/run/squid && \
    chmod 755 /var/run/squid

# Build the initial environment with python packages (without squid).
RUN test -n "$VERSION" \
    && echo "$VERSION" >/etc/qc_tool_version.txt \
    && apt-get -y update \
    && apt-get install -y --no-install-recommends \
        software-properties-common build-essential cmake git wget curl unzip time jq \
        gnupg2 ca-certificates \
        python3 python3-venv python3-dev python3-psycopg2 \
        openjdk-11-jre tini openssl apache2 gettext-base \
        libsqlite3-dev libspatialite-dev \
        libproj-dev libgeos-dev libgeos++-dev \
        libtiff-dev libjpeg-dev libpng-dev \
        libpq-dev libzstd-dev libgeotiff-dev \
        swig \
    && cd / && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    # numpy must be installed before GDAL python bindings are built
    && python3 -m venv --system-site-packages /opt/qc-tool \
    && /opt/qc-tool/bin/python3 -m pip install --no-cache-dir \
        setuptools==80.9.0 wheel==0.45.1 numpy==1.26.4 PyPDF2==3.0.1
    
# -------------------------------------------------------------
# --- Add Apache Arrow + Parquet dev packages (GeoParquet support) ---
RUN apt-get update && apt-get install -y -q lsb-release wget \
 && wget https://packages.apache.org/artifactory/arrow/ubuntu/apache-arrow-apt-source-latest-noble.deb \
 && apt install -y ./apache-arrow-apt-source-latest-noble.deb \
 && rm apache-arrow-apt-source-latest-noble.deb \
 && apt-get update && apt-get install -y \
        libarrow-dev=${ARROW_VERSION} libparquet-dev=${ARROW_VERSION} \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean


WORKDIR /tmp

# Keep custom GDAL under /usr/local. Noble's PostGIS dependencies also install
# distro GDAL 3.8.4; installing our Arrow-enabled build into /usr would let that
# package overwrite it and silently remove required Parquet support.
RUN curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      https://github.com/OSGeo/gdal/releases/download/v3.8.4/gdal-3.8.4.tar.gz --output gdal-3.8.4.tar.gz && \
    echo "${GDAL_SHA256}  gdal-3.8.4.tar.gz" | sha256sum --check --strict && \
    tar -xzf gdal-3.8.4.tar.gz && \
    cd gdal-3.8.4 && \
    mkdir build && cd build && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DGDAL_USE_TIFF=ON \
      -DGDAL_USE_PNG=ON \
      -DGDAL_USE_JPEG=ON \
      -DGDAL_USE_ZSTD=ON \
      -DGDAL_USE_POSTGRESQL=ON \
      -DGDAL_USE_SQLITE3=ON \
      -DGDAL_USE_SPATIALITE=ON \
      -DGDAL_USE_GEOTIFF_INTERNAL=OFF \
      -DGDAL_USE_ARROW=ON \
      -DGDAL_USE_PARQUET=ON \
      -DGDAL_ENABLE_DRIVER_GPKG=ON \
      -DGDAL_ENABLE_DRIVER_FLATGEOBUF=ON \
      -DGDAL_ENABLE_DRIVER_GTiff=ON \
      -DGDAL_ENABLE_DRIVER_PostgreSQL=ON \
      -DGDAL_ENABLE_DRIVER_ESRI_Shapefile=ON \
      -DBUILD_PYTHON_BINDINGS=ON \
      -DPython_EXECUTABLE=/opt/qc-tool/bin/python3 \
      -DGDAL_PYTHON_INSTALL_PREFIX=/opt/qc-tool \
      && make -j"${BUILD_JOBS}" && make install && ldconfig \
      && rm -rf /tmp/gdal-3.8.4 /tmp/gdal-3.8.4.tar.gz


WORKDIR /
# -------------------------------------------------------------
# Install python packages (except NumPy which was installed earlier).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libfreetype-dev \
    && rm -rf /var/lib/apt/lists/*
COPY docker/requirements.worker.txt /tmp/requirements.worker.txt
RUN python3 -m pip install --no-cache-dir --timeout 120 --retries 5 -r /tmp/requirements.worker.txt \
    && python3 -m pip uninstall --yes PyPDF2

# Copy supervisor config file.
COPY docker/supervisord.conf /etc

# Install postgresql version 17 & postgis version 3.
#
# Configure the PostgreSQL repository with HTTPS and a scoped keyring.
RUN curl --fail --show-error --location --proto '=https' --tlsv1.2 \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor --output /usr/share/keyrings/postgresql-archive.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql-archive.gpg] https://apt.postgresql.org/pub/repos/apt noble-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list

# Update the package lists to include PostgreSQL.
RUN apt-get update

# During install tzdata package needs timezone having been set already.
ENV TZ=UTC
RUN apt-get -y install postgresql-17-postgis-3

# PostGIS also installs the distro GDAL with the same soname. Debian's default
# architecture-library cache precedes /usr/local/lib, so explicitly retain the
# custom Arrow-enabled library as the first candidate after package triggers.
RUN printf '%s\n' /usr/local/lib > /etc/ld.so.conf.d/00-qc-tool-gdal.conf \
    && ldconfig

# Configure the qc tool database.
#
# We insert qc_job/trust clause just *before* 127.0.0.1/md5 clause in pg_hba.conf,
# so that qc_job is thus allowed to connect to qc_tool_db without password even
# when connecting to 127.0.0.1.
USER postgres
COPY docker/init_qc_tool_db.sql /usr/local/src
RUN sed --in-place=.orig --expression='/^# IPv4 local connections/a host  qc_tool_db  qc_job  127.0.0.1/32  trust' /etc/postgresql/17/main/pg_hba.conf \
    && echo "listen_addresses='127.0.0.1'" >>/etc/postgresql/17/main/postgresql.conf \
    && /etc/init.d/postgresql start \
    && psql --set=ON_ERROR_STOP=1 --file=/usr/local/src/init_qc_tool_db.sql \
    && /etc/init.d/postgresql stop
USER root
RUN rm -rf /var/lib/apt/lists/* /usr/local/src/init_qc_tool_db.sql

# Package the same checkout used by the frontend and CI. Never fetch mutable
# application branches during an image build.
COPY src /usr/local/src/copernicus_quality_tools/src
COPY product_definitions /usr/local/src/copernicus_quality_tools/product_definitions
COPY testing_data /usr/local/src/copernicus_quality_tools/testing_data
COPY docker /usr/local/src/copernicus_quality_tools/docker
COPY scripts /usr/local/src/copernicus_quality_tools/scripts
COPY pyproject.toml README.md LICENSE /usr/local/src/copernicus_quality_tools/
RUN python3 /usr/local/src/copernicus_quality_tools/docker/check_worker_runtime.py

RUN curl --fail --show-error --location --proto '=https' --tlsv1.2 \
         "https://github.com/INSPIRE-MIF/helpdesk-validator/releases/download/v${INSPIRE_VALIDATOR_VERSION}/inspire-validator-${INSPIRE_VALIDATOR_VERSION}.zip" \
         --output /tmp/inspire-validator.zip \
     && echo "${INSPIRE_VALIDATOR_SHA256}  /tmp/inspire-validator.zip" | sha256sum --check --strict \
     && unzip -q /tmp/inspire-validator.zip -d /tmp \
     && mv /tmp/validator.war /usr/local/jetty/webapps/validator.war \
     && mv /tmp/ui.zip ui.zip \
     && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
         "https://github.com/INSPIRE-MIF/helpdesk-validator/releases/download/v${INSPIRE_RESOURCES_VERSION}/ets-repository-${INSPIRE_RESOURCES_VERSION}.zip" \
         --output projects.zip \
     && echo "${INSPIRE_ETS_SHA256}  projects.zip" | sha256sum --check --strict \
     && mkdir -p ${ETF_DIR}/projects/${ETF_DL_TESTPROJECTS_DIR_NAME} \
     && unzip -o projects.zip -d ${ETF_DIR}/projects/${ETF_DL_TESTPROJECTS_DIR_NAME} \
     && rm -rf projects.zip /tmp/inspire-validator.zip /tmp/validator.war /tmp/ui.zip \
     && echo ${INSPIRE_VALIDATOR_VERSION} >/etc/inspire-validator-version.txt

# Download the INSPIRE registry resources
RUN mkdir -p /tmp/inspire-registry-resources \
     && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
         "https://github.com/INSPIRE-MIF/helpdesk-validator/releases/download/v${INSPIRE_RESOURCES_VERSION}/inspire-registry-resources.zip" \
         --output /tmp/inspire-registry-resources.zip \
     && echo "${INSPIRE_RESOURCES_SHA256}  /tmp/inspire-registry-resources.zip" | sha256sum --check --strict \
     && unzip -q /tmp/inspire-registry-resources.zip -d /tmp/inspire-registry-resources \
     && mkdir -p ${ETF_DIR}/inspire-registry-resources \
     && mv /tmp/inspire-registry-resources ${ETF_DIR}/inspire-registry-resources/ \
     && rm /tmp/inspire-registry-resources.zip

# Copy INSPIRE validator resources and prepare directories
COPY docker/inspire/docker-entrypoint.sh /
RUN chmod +x /docker-entrypoint.sh

# Copy the Squid configuration 
# and ensure correct permissions and create required directories.
COPY docker/inspire/squid_ubuntu.conf /etc/squid/squid.conf

RUN chmod 644 /etc/squid/squid.conf
RUN mkdir -p /var/log/supervisor /var/spool/squid /var/log/squid /var/run/squid \
    && cd /var/spool/squid \
    && chown -R proxy:proxy /var/spool/squid /var/log/squid /var/run/squid \
    && chmod -R 755 /var/run/squid /var/log/squid /var/spool/squid \
    && touch /var/log/squid/access.log /var/log/squid/cache.log \
    && chown proxy:proxy /var/log/squid/*.log

# Initialize Squid cache
RUN squid -N -z && chown -R proxy:proxy /var/spool/squid

# Copy the Apache configuration and enable correct Apache modules
COPY docker/inspire/apache_proxy.conf /etc/apache2/sites-available/proxy_1.conf
COPY docker/inspire/httpd.conf /etc/apache2/httpd.conf
COPY docker/inspire/apache_security.conf /etc/apache2/conf-available/qc-tool-security.conf
RUN a2enmod proxy proxy_http ssl \
    && a2enconf qc-tool-security \
    && a2ensite proxy_1.conf \
    && a2dissite 000-default.conf \
    && sed -i 's/^Listen 80$/Listen 127.0.0.1:80/' /etc/apache2/ports.conf

# Set up directories for jetty (inspire-validator app)
RUN mkdir -p $ETF_DIR $ETF_LOG_DIR /run/tini && \
    touch /run/tini/tini-ready
RUN mkdir /tmp/jetty
WORKDIR /usr/local/jetty

#REMEMBER the installed INSPIRE validator version and save it to a test file
RUN echo "$INSPIRE_VALIDATOR_VERSION" >/etc/inspire_validator_version.txt

# Run entrypoint for the inspire validator
ENTRYPOINT ["/docker-entrypoint.sh"]

# Optional service start entrypoints for supervisord. 
# These scripts check environment variables to decide whether to start the actual service or sleep indefinitely.
COPY docker/start_optional_postgres.sh /usr/local/bin/start_optional_postgres.sh
RUN chmod +x /usr/local/bin/start_optional_postgres.sh
COPY docker/start_optional_service.sh /usr/local/bin/start_optional_service.sh
RUN chmod +x /usr/local/bin/start_optional_service.sh

COPY docker/supervisord.conf /etc/supervisord.conf

# Expose the port of job scheduler.
EXPOSE 8000

CMD ["supervisord", "-c", "/etc/supervisord.conf"]
