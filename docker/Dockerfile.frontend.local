# Small development layer over the matching published runtime. The checkout is
# bind-mounted by compose.local.yaml, so rebuilding downloads no source tree and
# is only required when the base image or Python dependencies change.

ARG VERSION=2.4.7
FROM eeacms/copernicus-qctool-frontend:${VERSION}

LABEL author="gisat.cz"
LABEL description="QC Tool frontend development runtime with debugpy."

# 1.8.12 supports the Python 3.8/glibc versions in the Ubuntu Focal base image.
ARG DEBUGPY_VERSION=1.8.12
RUN python3 -m pip install --no-cache-dir "debugpy==${DEBUGPY_VERSION}"

COPY ./run_frontend.sh /run_frontend.sh
RUN chmod +x /run_frontend.sh

EXPOSE 5678
