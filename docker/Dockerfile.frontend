# Pin the supported Python patch and multi-architecture image manifest. Update
# both together after the image scan and runtime regression suite pass.
FROM python:3.12.14-slim-trixie@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

LABEL author="gisat.cz"
LABEL description="QC Tool frontend service"

ARG VERSION

ENV PYTHONPATH=/usr/local/src/copernicus_quality_tools/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    QC_TOOL_ENVIRONMENT=production \
    VERSION=${VERSION} \
    TZ=Europe/Prague

RUN test -n "$VERSION" \
    && echo "$VERSION" >/etc/qc_tool_version.txt \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        tzdata \
        unzip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.frontend.txt /tmp/requirements.frontend.txt
RUN python -m pip install --no-cache-dir \
        -r /tmp/requirements.frontend.txt

RUN mkdir -p /tmp/qc-tool-source /usr/local/src \
    && python -c "import os, urllib.request; version = os.environ['VERSION']; urllib.request.urlretrieve('https://github.com/eea/copernicus_quality_tools/archive/' + version + '.zip', '/tmp/qc-tool-source.zip')" \
    && unzip -q /tmp/qc-tool-source.zip -d /tmp/qc-tool-source \
    && extracted_dir="$(find /tmp/qc-tool-source -mindepth 1 -maxdepth 1 -type d -print -quit)" \
    && test -n "$extracted_dir" \
    && mv "$extracted_dir" /usr/local/src/copernicus_quality_tools \
    && rm -rf /tmp/qc-tool-source /tmp/qc-tool-source.zip \
    && mkdir -p /var/lib/qc_tool

EXPOSE 8000

COPY run_frontend.sh /run_frontend.sh
RUN chmod 0755 /run_frontend.sh

CMD ["/run_frontend.sh"]
