# Pin the supported Python patch and multi-architecture image manifest.
FROM python:3.12.14-slim-trixie@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

LABEL author="gisat.cz"
LABEL description="QC Tool frontend service"

ARG POSTGRES_CLIENT_MAJOR=17

ENV PYTHONPATH=/usr/local/src/copernicus_quality_tools/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    QC_TOOL_ENVIRONMENT=production \
    TZ=Europe/Prague

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        tzdata \
        "postgresql-client-${POSTGRES_CLIENT_MAJOR}" \
    && pg_dump --version && pg_restore --version \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.frontend.txt /tmp/requirements.frontend.txt
RUN python -m pip install --no-cache-dir \
        -r /tmp/requirements.frontend.txt

# The checkout is the build input.
COPY src /usr/local/src/copernicus_quality_tools/src
COPY product_definitions /usr/local/src/copernicus_quality_tools/product_definitions
COPY testing_data /usr/local/src/copernicus_quality_tools/testing_data
COPY docker /usr/local/src/copernicus_quality_tools/docker
COPY scripts /usr/local/src/copernicus_quality_tools/scripts
COPY docs/deployment/storage-access.md /usr/local/src/copernicus_quality_tools/docs/deployment/storage-access.md
COPY pyproject.toml README.md LICENSE /usr/local/src/copernicus_quality_tools/
RUN mkdir -p /var/lib/qc_tool \
    && python3 -c "import sys; assert sys.version_info >= (3, 11)"

EXPOSE 8000

COPY docker/run_frontend.sh /run_frontend.sh
RUN chmod 0755 /run_frontend.sh

ARG VERSION
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/eea/copernicus_quality_tools" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
ENV VERSION=${VERSION}
RUN test -n "$VERSION" && echo "$VERSION" >/etc/qc_tool_version.txt

CMD ["/run_frontend.sh"]