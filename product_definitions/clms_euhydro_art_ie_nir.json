{
  "description": "EU Hydro Hydro-ART vector (Ireland)",
  "steps": [
    {
      "check_ident": "qc_tool.raster.unzip",
      "required": true
    },
    {
      "check_ident": "qc_tool.vector.naming",
      "required": true,
      "parameters": {
        "reference_year": "2026",
        "formats": [
          ".gpkg", ".fgb"
        ],
        "layer_names": {
          "WATERCOURSE_LINE": "art_artificial_watercourse_line_(?P<aoi_code>ie_nir)",
          "WATERCOURSE_POLYGON": "art_artificial_watercourse_polygon_(?P<aoi_code>ie_nir)",
          "LONGITUDINAL_STRUCTURE": "art_longitudinal_connectivity_structure_(?P<aoi_code>ie_nir)",
          "LATERAL_STRUCTURE": "art_coastal_protection_lateral_connectivity_structure_(?P<aoi_code>ie_nir)"
        },
        "gpkg_filename_regex": "^clms_euhydro_net_(?P<aoi_code>[0-9a-zA-Z_]+)_v[0-9]{2}"
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "WATERCOURSE_LINE"
        ],
        "required": {
          "fid": "integer"
        },
        "ignored": ["objectid"]
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "WATERCOURSE_POLYGON"
        ],
        "required": {
          "fid": "integer"
        },
        "ignored": ["objectid"]
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "LONGITUDINAL_STRUCTURE"
        ],
        "required": {
          "fid": "integer"
        },
        "ignored": ["objectid"]
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "LATERAL_STRUCTURE"
        ],
        "required": {
          "fid": "integer"
        },
        "ignored": ["objectid"]
      }
    },
    
    {
      "check_ident": "qc_tool.vector.geometry_type",
      "required": true,
      "parameters": {
        "layers": ["LONGITUDINAL_STRUCTURE"],
        "geometry_type": "POINT"
      }
    },
    {
      "check_ident": "qc_tool.vector.geometry_type",
      "required": true,
      "parameters": {
        "layers": ["WATERCOURSE_LINE", "LATERAL_STRUCTURE"],
        "geometry_type": ["LINESTRING", "MULTILINESTRING"]
      }
    },
    {
      "check_ident": "qc_tool.vector.epsg",
      "required": true,
      "parameters": {
        "layers": [
          "WATERCOURSE_LINE", "LONGITUDINAL_STRUCTURE", "LATERAL_STRUCTURE"
        ],
        "epsg": 3035,
        "auto_identify_epsg": false
      }
    },
    {
      "check_ident": "qc_tool.vector.import2pg",
      "required": true
    },
    {
      "check_ident": "qc_tool.vector.unique",
      "required": false,
      "parameters": {
        "layers": [
          "LONGITUDINAL_STRUCTURE"
        ],
        "unique_keys": ["node_id"]
      }
    },
    {
      "check_ident": "qc_tool.vector.unique",
      "required": false,
      "parameters": {
        "layers": [
          "WATERCOURSE_LINE", "LATERAL_STRUCTURE"
        ],
        "unique_keys": ["strm_id"]
      }
    },
    {
      "check_ident": "qc_tool.vector.enum",
      "required": false,
      "parameters": {
        "layers": [
          "LONGITUDINAL_STRUCTURE", "WATERCOURSE_LINE", "LATERAL_STRUCTURE"
        ],
        "column_defs": [
          ["carto", [
            "YES", "NO"
          ]]
        ]
      }
    },
    {
      "check_ident": "qc_tool.vector.geometry",
      "required": false,
      "parameters": {
        "layers": ["WATERCOURSE_LINE", "LATERAL_STRUCTURE", "LONGITUDINAL_STRUCTURE"]
      }
    },
    {
      "check_ident": "qc_tool.vector.mml",
      "required": false,
      "parameters": {
        "layers": ["WATERCOURSE_LINE", "LATERAL_STRUCTURE"],
        "mml": 10.0,
        "line_geometry": true,
        "warning_where": "ST_Length(geom) < 10.0"
      }
    }
  ]
}
