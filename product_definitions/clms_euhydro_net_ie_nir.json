{
  "description": "EU Hydro Hydro-NET vector (Ireland)",
  "steps": [
    {
      "check_ident": "qc_tool.raster.unzip",
      "required": true
    },
    {
      "check_ident": "qc_tool.vector.naming",
      "required": true,
      "parameters": {
        "reference_year": "2026",
        "formats": [
          ".gpkg", ".fgb"
        ],
        "layer_names": {
          "NODES": "net_nodes_(?P<aoi_code>ie_nir)",
          "NODES_CARTO": "net_nodes_carto_(?P<aoi_code>ie_nir)",
          "STREAMS": "net_streams_(?P<aoi_code>ie_nir)",
          "STREAMS_CARTO": "net_streams_carto_(?P<aoi_code>ie_nir)"
        },
        "gpkg_filename_regex": "^clms_euhydro_net_(?P<aoi_code>[0-9a-zA-Z_]+)_v[0-9]{2}",
        "aoi_codes": ["ie_nir"]
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "NODES"
        ],
        "required": {
          "NODE_ID": "integer",
          "NODE_ID_UP": "string",
          "NODE_ID_DOWN": "integer",
          "BRANCH": "integer",
          "BRANCH_ID": "string"
        },
        "ignored": ["OBJECTID"]
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "NODES_CARTO"
        ],
        "required": {
          "NODE_ID": "integer",
          "NODE_ID_UP": "string",
          "NODE_ID_DOWN": "integer",
          "BRANCH": "integer",
          "BRANCH_ID": "string",
          "CARTO": "string"
        },
        "ignored": ["OBJECTID"]
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "STREAMS"
        ],
        "required": {
          "STRM_ID": "integer",
          "STRM_DN": "integer",
          "STRM_UP": "string",
          "GRID_CODE": "integer",
          "HYBAS_ID": "string",
          "MAIN_BAS": "integer",
          "NODE_ID_UP": "integer",
          "NODE_ID_DN": "integer",
          "LENGTH_KM": "real",
          "UP_CELLS": "real",
          "UPSTREAM_KM": "real",
          "UPLAND_SKM": "real",
          "DIST_UP_KM": "real",
          "DIST_DN_KM": "real",
          "ORD_STRA": "integer",
          "ORD_SHRE": "integer",
          "ORD_HACK": "integer",
          "ORD_HACK_ID": "integer",
          "BRANCH": "integer",
          "MAIN_LINK": "integer",
          "LINK_STRM_ID": "string"
        },
        "ignored": ["OBJECTID"]
      }
    },
    {
      "check_ident": "qc_tool.vector.attribute",
      "required": true,
      "parameters": {
        "layers": [
          "STREAMS_CARTO"
        ],
        "required": {
          "STRM_ID": "integer",
          "STRM_DN": "integer",
          "STRM_UP": "string",
          "GRID_CODE": "integer",
          "HYBAS_ID": "string",
          "MAIN_BAS": "integer",
          "NODE_ID_UP": "integer",
          "NODE_ID_DN": "integer",
          "LENGTH_KM": "real",
          "UP_CELLS": "real",
          "UPSTREAM_KM": "real",
          "UPLAND_SKM": "real",
          "DIST_UP_KM": "real",
          "DIST_DN_KM": "real",
          "ORD_STRA": "integer",
          "ORD_SHRE": "integer",
          "ORD_HACK": "integer",
          "ORD_HACK_ID": "integer",
          "BRANCH": "integer",
          "MAIN_LINK": "integer",
          "LINK_STRM_ID": "string",
          "CARTO": "string"
        },
        "ignored": ["OBJECTID"]
      }
    },
    
    {
      "check_ident": "qc_tool.vector.geometry_type",
      "required": true,
      "parameters": {
        "layers": ["NODES", "NODES_CARTO"],
        "geometry_type": "POINT"
      }
    },
    {
      "check_ident": "qc_tool.vector.geometry_type",
      "required": true,
      "parameters": {
        "layers": ["STREAMS", "STREAMS_CARTO"],
        "geometry_type": ["LINESTRING", "MULTILINESTRING"]
      }
    },
    {
      "check_ident": "qc_tool.vector.epsg",
      "required": true,
      "parameters": {
        "layers": [
          "NODES", "NODES_CARTO", "STREAMS", "STREAMS_CARTO"
        ],
        "epsg": 3035,
        "auto_identify_epsg": false
      }
    },
    {
      "check_ident": "qc_tool.vector.import2pg",
      "required": true
    },
    {
      "check_ident": "qc_tool.vector.unique",
      "required": false,
      "parameters": {
        "layers": [
          "NODES", "NODES_CARTO"
        ],
        "unique_keys": ["NODE_ID"]
      }
    },
    {
      "check_ident": "qc_tool.vector.unique",
      "required": false,
      "parameters": {
        "layers": [
          "STREAMS", "STREAMS_CARTO"
        ],
        "unique_keys": ["STRM_ID"]
      }
    },
    {
      "check_ident": "qc_tool.vector.enum",
      "required": false,
      "parameters": {
        "layers": [
          "NODES_CARTO", "STREAMS_CARTO"
        ],
        "column_defs": [
          ["CARTO", [
            "YES", "NO"
          ]]
        ]
      }
    },
    {
      "check_ident": "qc_tool.vector.geometry",
      "required": false,
      "parameters": {
        "layers": ["STREAMS", "STREAMS_CARTO", "NODES", "NODES_CARTO"]
      }
    },
    {
      "check_ident": "qc_tool.vector.mml",
      "required": false,
      "parameters": {
        "layers": ["STREAMS"],
        "mml": 10.0,
        "line_geometry": true,
        "error_where": "ST_Length(geom) < 15.0"
      }
    }
  ]
}
