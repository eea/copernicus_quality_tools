{
  "description": "EU Hydro Hydro-BAS vector (Ireland)",
  "steps": [
    {
      "check_ident": "qc_tool.raster.unzip",
      "required": true
    },
    {
      "check_ident": "qc_tool.vector.naming",
      "required": true,
      "parameters": {
        "reference_year": "2026",
        "formats": [
          ".gpkg", ".fgb"
        ],
        "layer_names": {
          "BAS_L2": "bas_l2",
          "BAS_L2_CARTO": "bas_l2_carto",
          "BAS_L3": "bas_l3",
          "BAS_L3_CARTO": "bas_l3_carto",
          "BAS_L4": "bas_l4",
          "BAS_L4_CARTO": "bas_l4_carto",
          "BAS_L5": "bas_l5",
          "BAS_L5_CARTO": "bas_l5_carto",
          "BAS_L6": "bas_l6",
          "BAS_L6_CARTO": "bas_l6_carto",
          "BAS_L7": "bas_l7",
          "BAS_L7_CARTO": "bas_l7_carto"
        },
        "gpkg_filename_regex": "^clms_euhydro_bas_(?P<aoi_code>[0-9a-zA-Z_]+)_v[0-9]{2}"
      }
    }
  ]
}
